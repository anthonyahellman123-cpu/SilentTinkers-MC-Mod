		{
			dependencies: ["51A17E17A5C0DE02"]
			description: [
				"&6The basic loop&r"
				""
				"1. Choose an ingot or material recognized by Silent Gear."
				"2. Melt it in a Tinkers melter or smeltery."
				"3. Cast the molten composite into a compatible Tinkers tool part."
				"4. Assemble it with any other valid Tinkers materials."
				""
				"The molten fluid, cast part, and completed tool preserve their dynamic composition and calculated stats."
			]
			hide_until_deps_complete: true
			icon: "tconstruct:smeltery_controller"
			id: "51A17E17A5C0DE10"
			title: "Getting Started"
